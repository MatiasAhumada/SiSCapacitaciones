server {
    listen 80;
    listen [::]:80;
    server_name __STAGING_FRONTEND_HOST__ __STAGING_API_HOST__;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STAGING_API_HOST__;

    ssl_certificate /etc/letsencrypt/live/__STAGING_API_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_API_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header X-Deployment-Environment staging always;
    add_header X-Deployment-Commit __DEPLOYMENT_SHA__ always;

    location /backend/ {
        proxy_pass http://127.0.0.1:4043/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 60s;
    }

    location = /backend {
        return 301 /backend/;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __STAGING_FRONTEND_HOST__;

    ssl_certificate /etc/letsencrypt/live/__STAGING_FRONTEND_HOST__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__STAGING_FRONTEND_HOST__/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    root /var/www/siscapacitaciones-staging/current;
    index index.html;

    add_header X-Deployment-Environment staging always;
    add_header X-Deployment-Commit __DEPLOYMENT_SHA__ always;

    location = /health {
        default_type application/json;
        return 200 '{"status":"ok","environment":"staging","commit":"__DEPLOYMENT_SHA__"}';
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
